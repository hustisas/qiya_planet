<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.planet.wp.admin.module.business.qiya.dao.ResetDao">
    <select id="query" resultType="com.study.planet.wp.admin.module.business.qiya.domain.vo.ResetVO">
        SELECT * FROM t_qiya_reset
        <where>
            deleted_flag = 0
            <if test="query.searchWord != null and query.searchWord != ''">
                AND (
                INSTR(scene_name, #{query.searchWord})
                OR INSTR(reset_kind, #{query.searchWord})
                OR INSTR(pay_text, #{query.searchWord})
                )
            </if>
        </where>
        ORDER BY reset_id DESC
    </select>
</mapper>
