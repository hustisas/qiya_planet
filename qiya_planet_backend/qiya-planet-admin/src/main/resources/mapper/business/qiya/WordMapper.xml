<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.planet.wp.admin.module.business.qiya.dao.WordDao">
    <select id="query" resultType="com.study.planet.wp.admin.module.business.qiya.domain.vo.WordVO">
        SELECT * FROM t_qiya_word
        <where>
            deleted_flag = 0
            <if test="query.searchWord != null and query.searchWord != ''">
                AND (
                INSTR(en, #{query.searchWord})
                OR INSTR(zh, #{query.searchWord})
                OR INSTR(theme_name, #{query.searchWord})
                OR INSTR(mastery, #{query.searchWord})
                )
            </if>
            <if test="query.statusName != null and query.statusName != ''">
                AND mastery = #{query.statusName}
            </if>
        </where>
        ORDER BY word_id DESC
    </select>
</mapper>
