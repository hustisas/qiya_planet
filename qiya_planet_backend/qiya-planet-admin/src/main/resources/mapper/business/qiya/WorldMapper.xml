<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.planet.wp.admin.module.business.qiya.dao.WorldDao">
    <select id="query" resultType="com.study.planet.wp.admin.module.business.qiya.domain.vo.WorldVO">
        SELECT * FROM t_qiya_world
        <where>
            deleted_flag = 0
            <if test="query.searchWord != null and query.searchWord != ''">
                AND (
                INSTR(world_name, #{query.searchWord})
                OR INSTR(level_name, #{query.searchWord})
                OR INSTR(weak_word, #{query.searchWord})
                )
            </if>
        </where>
        ORDER BY world_id DESC
    </select>
</mapper>
